rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // TEMPORARY: Simplified rules for testing
    // TODO: Re-harden after confirming uploads work
    
    // Profile photos: /profilePhotos/{uid}/
    match /profilePhotos/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy profile path: /profiles/{uid}/
    match /profiles/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Message images: /conversations/{cid}/messages/{file}
    // TEMPORARY: Auth-only (no participant check)
    match /conversations/{cid}/messages/{file} {
      allow read, write: if request.auth != null;
    }

    // Session Intelligence: /recordings/{cid}/{file}
    // Lecture recordings (video/audio) uploaded by tutors
    match /recordings/{cid}/{file} {
      // Allow authenticated users to read (will be validated by Firestore rules)
      allow read: if request.auth != null;
      
      // Allow authenticated users to write (conversation participant check in app logic)
      allow write: if request.auth != null;
    }
  }
}
