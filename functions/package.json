{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for MessageAI push notifications",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@google-cloud/functions-framework": "^4.0.0",
    "@types/uuid": "^11.0.0",
    "ai": "^4.0.0",
    "chrono-node": "^2.7.6",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.0.0",
    "expo-server-sdk": "^3.7.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "luxon": "^3.4.4",
    "openai": "^6.8.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
